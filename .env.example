FASTAPI_DEBUG=true
FASTAPI_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# War Dynamics (Durations in minutes)
PREPARATION_DURATION_MINUTES=60
BATTLE_DURATION_MINUTES=60

