# Firebase Configuration
FIREBASE_PROJECT_ID=clash-of-codes-dev
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# Judge0 Execution Engine
JUDGE0_API_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=

# FastAPI Backend
